<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jana's Magical Birthday ✨</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        @import url('https://fonts.googleapis.com/css2?family=Raleway:wght@200;300;400;700;900&family=Cinzel:wght@400;700&display=swap');

        body {
            font-family: 'Raleway', sans-serif;
            background: #0a0e27;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            position: relative;
        }

        /* Animated starry background */
        .stars {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        .star {
            position: absolute;
            width: 2px;
            height: 2px;
            background: white;
            border-radius: 50%;
            animation: twinkle 3s infinite;
        }

        @keyframes twinkle {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.5); }
        }

        /* Aurora effect */
        .aurora {
            position: fixed;
            width: 200%;
            height: 200%;
            top: -50%;
            left: -50%;
            background: radial-gradient(ellipse at center, 
                rgba(138, 43, 226, 0.3) 0%,
                rgba(147, 112, 219, 0.2) 25%,
                rgba(216, 191, 216, 0.1) 50%,
                transparent 70%);
            animation: aurora 20s ease-in-out infinite;
            pointer-events: none;
        }

        @keyframes aurora {
            0%, 100% { transform: rotate(0deg) scale(1); opacity: 0.5; }
            33% { transform: rotate(120deg) scale(1.1); opacity: 0.7; }
            66% { transform: rotate(240deg) scale(0.9); opacity: 0.6; }
        }

        /* Floating particles */
        .particle {
            position: fixed;
            width: 4px;
            height: 4px;
            background: radial-gradient(circle, #da70d6, transparent);
            border-radius: 50%;
            pointer-events: none;
            animation: float 15s infinite;
        }

        @keyframes float {
            0% {
                transform: translateY(100vh) translateX(0) scale(0);
                opacity: 0;
            }
            10% {
                opacity: 1;
            }
            90% {
                opacity: 1;
            }
            100% {
                transform: translateY(-100px) translateX(100px) scale(1);
                opacity: 0;
            }
        }

        .container {
            text-align: center;
            padding: 30px;
            background: rgba(15, 12, 41, 0.75);
            backdrop-filter: blur(20px);
            border-radius: 40px;
            box-shadow: 
                0 0 60px rgba(147, 112, 219, 0.4),
                inset 0 0 60px rgba(138, 43, 226, 0.1);
            border: 2px solid rgba(186, 85, 211, 0.3);
            max-width: 900px;
            width: 90%;
            position: relative;
            z-index: 10;
            margin: 20px auto;
        }

        .magic-circle {
            position: absolute;
            width: 300px;
            height: 300px;
            border: 2px solid rgba(186, 85, 211, 0.3);
            border-radius: 50%;
            animation: rotate 30s linear infinite;
        }

        .magic-circle:nth-child(1) {
            top: -150px;
            left: -150px;
        }

        .magic-circle:nth-child(2) {
            bottom: -150px;
            right: -150px;
            animation-direction: reverse;
        }

        @keyframes rotate {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        h1 {
            font-family: 'Cinzel', serif;
            color: #fff;
            font-size: 2.8rem;
            margin-bottom: 15px;
            text-shadow: 
                0 0 10px rgba(147, 112, 219, 0.8),
                0 0 20px rgba(138, 43, 226, 0.6),
                0 0 30px rgba(186, 85, 211, 0.4);
            animation: glow 3s ease-in-out infinite;
            font-weight: 700;
            letter-spacing: 3px;
        }

        @keyframes glow {
            0%, 100% {
                text-shadow: 
                    0 0 10px rgba(147, 112, 219, 0.8),
                    0 0 20px rgba(138, 43, 226, 0.6),
                    0 0 30px rgba(186, 85, 211, 0.4);
            }
            50% {
                text-shadow: 
                    0 0 20px rgba(147, 112, 219, 1),
                    0 0 30px rgba(138, 43, 226, 0.8),
                    0 0 40px rgba(186, 85, 211, 0.6);
            }
        }

        .subtitle {
            color: #d8bfd8;
            font-size: 1.2rem;
            margin-bottom: 30px;
            font-weight: 300;
            letter-spacing: 2px;
            animation: fadeIn 2s ease;
        }

        .countdown {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
            margin: 30px 0;
        }

        .time-unit {
            background: linear-gradient(135deg, 
                rgba(75, 0, 130, 0.4) 0%,
                rgba(138, 43, 226, 0.3) 100%);
            padding: 20px 15px;
            border-radius: 20px;
            min-width: 100px;
            border: 2px solid rgba(186, 85, 211, 0.5);
            box-shadow: 
                0 8px 32px rgba(138, 43, 226, 0.3),
                inset 0 0 20px rgba(186, 85, 211, 0.1);
            position: relative;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .time-unit::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                45deg,
                transparent,
                rgba(186, 85, 211, 0.2),
                transparent
            );
            animation: shimmer 3s infinite;
        }

        @keyframes shimmer {
            0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
            100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
        }

        .time-unit:hover {
            transform: translateY(-10px) scale(1.05);
            box-shadow: 
                0 15px 40px rgba(138, 43, 226, 0.5),
                inset 0 0 30px rgba(186, 85, 211, 0.2);
        }

        .time-value {
            font-size: 2.8rem;
            font-weight: 900;
            color: #fff;
            text-shadow: 
                0 0 10px rgba(186, 85, 211, 0.8),
                0 0 20px rgba(138, 43, 226, 0.6);
            position: relative;
            z-index: 1;
        }

        .time-label {
            font-size: 0.9rem;
            color: #d8bfd8;
            margin-top: 10px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 300;
            position: relative;
            z-index: 1;
        }

        .birthday-message {
            display: none;
            animation: mysticalAppear 2s ease;
        }

        @keyframes mysticalAppear {
            0% {
                opacity: 0;
                transform: scale(0.5) rotateY(180deg);
            }
            100% {
                opacity: 1;
                transform: scale(1) rotateY(0deg);
            }
        }

        .birthday-message h2 {
            font-family: 'Cinzel', serif;
            color: #fff;
            font-size: 3rem;
            margin-bottom: 15px;
            text-shadow: 
                0 0 20px rgba(147, 112, 219, 1),
                0 0 40px rgba(138, 43, 226, 0.8);
            animation: textFloat 3s ease-in-out infinite;
            font-weight: 700;
        }

        @keyframes textFloat {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }

        .name-highlight {
            font-family: 'Cinzel', serif;
            background: linear-gradient(135deg, #da70d6, #ba55d3, #9370db);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
            font-size: 4rem;
            display: block;
            margin: 20px 0;
            animation: nameGlow 2s infinite, namePulse 3s ease-in-out infinite;
            letter-spacing: 6px;
            position: relative;
        }

        @keyframes nameGlow {
            0%, 100% {
                filter: drop-shadow(0 0 20px rgba(218, 112, 214, 0.8));
            }
            50% {
                filter: drop-shadow(0 0 40px rgba(186, 85, 211, 1));
            }
        }

        @keyframes namePulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        /* Photo gallery with magical transitions */
        .photo-gallery {
            width: 100%;
            max-width: 450px;
            height: 350px;
            margin: 25px auto;
            border-radius: 30px;
            overflow: hidden;
            position: relative;
            box-shadow: 
                0 0 60px rgba(138, 43, 226, 0.6),
                0 0 100px rgba(186, 85, 211, 0.4);
            border: 3px solid rgba(186, 85, 211, 0.6);
        }

        .photo-gallery::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                45deg,
                transparent 30%,
                rgba(186, 85, 211, 0.3) 50%,
                transparent 70%
            );
            animation: photoShine 4s infinite;
            z-index: 2;
            pointer-events: none;
        }

        @keyframes photoShine {
            0% { transform: translateX(-100%) translateY(-100%) rotate(45deg); }
            100% { transform: translateX(100%) translateY(100%) rotate(45deg); }
        }

        .photo-gallery img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            opacity: 0;
            transform: scale(1.1);
            transition: all 1.5s ease-in-out;
        }

        .photo-gallery img.active {
            opacity: 1;
            transform: scale(1);
        }

        .photo-gallery img.exiting {
            opacity: 0;
            transform: scale(0.9) rotate(5deg);
        }

        .message-text {
            color: #e6e6fa;
            font-size: 1.3rem;
            line-height: 1.8;
            text-shadow: 0 2px 10px rgba(138, 43, 226, 0.5);
            font-weight: 300;
            margin-top: 25px;
            animation: fadeIn 3s ease;
        }

        .custom-paragraph {
            color: #dda0dd;
            font-size: 1.1rem;
            line-height: 1.6;
            margin-top: 25px;
            padding: 20px;
            background: rgba(75, 0, 130, 0.2);
            border-radius: 20px;
            border: 1px solid rgba(186, 85, 211, 0.3);
            font-style: italic;
            animation: fadeIn 4s ease;
        }

        /* Magical sparkles */
        .sparkle {
            position: fixed;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, #fff, transparent);
            border-radius: 50%;
            pointer-events: none;
            animation: sparkleAnimation 2s infinite;
        }

        @keyframes sparkleAnimation {
            0%, 100% {
                opacity: 0;
                transform: scale(0);
            }
            50% {
                opacity: 1;
                transform: scale(1);
            }
        }

        /* Magical moon */
        .moon {
            position: fixed;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: radial-gradient(circle at 30% 30%, 
                #fff 0%,
                #e6e6fa 40%,
                #d8bfd8 100%);
            box-shadow: 
                0 0 60px rgba(255, 255, 255, 0.4),
                inset -20px -20px 40px rgba(138, 43, 226, 0.2);
            top: 50px;
            right: 50px;
            animation: moonGlow 4s ease-in-out infinite;
            z-index: 5;
        }

        @keyframes moonGlow {
            0%, 100% {
                box-shadow: 
                    0 0 60px rgba(255, 255, 255, 0.4),
                    inset -20px -20px 40px rgba(138, 43, 226, 0.2);
            }
            50% {
                box-shadow: 
                    0 0 100px rgba(255, 255, 255, 0.6),
                    inset -20px -20px 40px rgba(138, 43, 226, 0.3);
            }
        }

        .magic-wand {
            font-size: 3.5rem;
            animation: wandFloat 3s ease-in-out infinite;
            display: inline-block;
            margin: 15px 0;
            filter: drop-shadow(0 5px 20px rgba(186, 85, 211, 0.8));
        }

        @keyframes wandFloat {
            0%, 100% {
                transform: translateY(0px) rotate(-15deg);
            }
            50% {
                transform: translateY(-15px) rotate(15deg);
            }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @media (max-width: 768px) {
            h1 { font-size: 2.5rem; }
            .subtitle { font-size: 1.2rem; }
            .time-unit { min-width: 90px; padding: 20px; }
            .time-value { font-size: 2.5rem; }
            .birthday-message h2 { font-size: 2.8rem; }
            .name-highlight { font-size: 3.5rem; }
            .message-text { font-size: 1.3rem; }
            .custom-paragraph { font-size: 1.2rem; padding: 20px; }
            .photo-gallery { height: 350px; }
            .moon { width: 80px; height: 80px; top: 20px; right: 20px; }
        }
    </style>
</head>
<body>
    <!-- Starry background -->
    <div class="stars" id="starsContainer"></div>
    
    <!-- Aurora effect -->
    <div class="aurora"></div>
    
    <!-- Moon -->
    <div class="moon"></div>
    
    <!-- Particles -->
    <div id="particlesContainer"></div>

    <div class="container">
        <div class="magic-circle"></div>
        <div class="magic-circle"></div>
        
        <div id="countdown-section">
            <h1>💜 Jana's Birthday Countdown 💜</h1>
            <p class="subtitle">A magical celebration awaits...</p>
            
            <div class="countdown" id="countdown">
                <div class="time-unit">
                    <div class="time-value" id="days">0</div>
                    <div class="time-label">Days</div>
                </div>
                <div class="time-unit">
                    <div class="time-value" id="hours">0</div>
                    <div class="time-label">Hours</div>
                </div>
                <div class="time-unit">
                    <div class="time-value" id="minutes">0</div>
                    <div class="time-label">Minutes</div>
                </div>
                <div class="time-unit">
                    <div class="time-value" id="seconds">0</div>
                    <div class="time-label">Seconds</div>
                </div>
            </div>
        </div>

        <div class="birthday-message" id="birthday-message">
            <div class="magic-wand">🪄</div>
            <h2>✨ HAPPY BIRTHDAY ✨</h2>
            <span class="name-highlight">JANA</span>
            
            <div class="photo-gallery" id="photoGallery">
